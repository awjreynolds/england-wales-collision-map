{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "weca-national-query",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "vars": {
    "API_VERSION": "national.v1"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "england-wales-collisions-2021-2025",
      "database_id": "c7940d03-5764-4686-9e75-61296753ebd8",
      "migrations_dir": "./migrations"
    }
  ]
}
